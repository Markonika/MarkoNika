<?xml version='1.0' encoding='utf-8'?>
<fluidity_options>
  <simulation_name>
    <string_value lines="1">msfr_wedge_midplane_2d</string_value>
  </simulation_name>
  <problem_type>
    <string_value lines="1">fluids</string_value>
  </problem_type>
  <!--
    Flat 2D (r,z) cross-section sliced from the real 3D wedge at its
    angular midplane (theta=11.25 deg, where the real inlet/outlet
    channel sits), remeshed properly with gmsh's Frontal-Delaunay mesher
    (slice_midplane_2d.py + remesh_midplane_2d.py), NOT an axisymmetric
    reduction: Fluidity has no native axisymmetric solver (confirmed
    early in this project), so this is a true flat domain, missing the
    1/r geometric term a real axisymmetric formulation would carry. For
    fast iteration on BC/solver/turbulence-model settings before
    committing to slow 3D runs; not a physically equivalent reduced
    model of the full reactor.
  -->
  <geometry>
    <dimension>
      <integer_value rank="0">2</integer_value>
    </dimension>
    <mesh name="CoordinateMesh">
      <from_file file_name="msfr_wedge_midplane_2d_remeshed">
        <format name="gmsh"/>
        <stat>
          <include_in_stat/>
        </stat>
      </from_file>
    </mesh>
    <mesh name="VelocityMesh">
      <from_mesh>
        <mesh name="CoordinateMesh"/>
        <stat>
          <exclude_from_stat/>
        </stat>
      </from_mesh>
    </mesh>
    <mesh name="PressureMesh">
      <from_mesh>
        <mesh name="CoordinateMesh"/>
        <stat>
          <exclude_from_stat/>
        </stat>
      </from_mesh>
    </mesh>
    <quadrature>
      <degree>
        <integer_value rank="0">3</integer_value>
      </degree>
    </quadrature>
  </geometry>
  <io>
    <dump_format>
      <string_value>vtk</string_value>
    </dump_format>
    <dump_period>
      <constant>
        <real_value rank="0">1.0</real_value>
      </constant>
    </dump_period>
    <output_mesh name="VelocityMesh"/>
    <!--
      checkpoint_period_in_dumps=1 (not 5): a 30-minute background run
      only reached t~1.24s (dump_period=1.0, so 2 dumps), never enough to
      hit a checkpoint at period=5 - meaning that run couldn't be resumed
      at all when the background time limit cut it off, only restarted
      from t=0. Checkpointing every dump costs more disk/time but makes
      long runs actually resumable.
    -->
    <checkpointing>
      <checkpoint_period_in_dumps>
        <integer_value rank="0">1</integer_value>
      </checkpoint_period_in_dumps>
    </checkpointing>
    <stat/>
  </io>
  <timestepping>
    <current_time>
      <real_value rank="0">0</real_value>
    </current_time>
    <timestep>
      <real_value rank="0">0.02</real_value>
    </timestep>
    <finish_time>
      <real_value rank="0">20.0</real_value>
    </finish_time>
    <nonlinear_iterations>
      <integer_value rank="0">2</integer_value>
    </nonlinear_iterations>
    <adaptive_timestep>
      <requested_cfl>
        <real_value rank="0">3.0</real_value>
      </requested_cfl>
      <courant_number name="CFLNumber">
        <mesh name="VelocityMesh"/>
      </courant_number>
      <maximum_timestep>
        <real_value rank="0">0.1</real_value>
      </maximum_timestep>
      <increase_tolerance>
        <real_value rank="0">1.2</real_value>
      </increase_tolerance>
    </adaptive_timestep>
    <!--
      Steady-state auto-termination, per user request to investigate
      the steady (not transient) flow: Fluidity has no separate steady
      solver, so this still marches the ramped transient forward but
      stops once it actually converges, instead of guessing finish_time.
      Checked on Velocity only (Pressure is deliberately
      exclude_from_steady_state above - Velocity (~0-4 m/s) and Pressure
      (~O(1e3-1e4) Pa) are too different in scale to share one absolute
      tolerance meaningfully, and velocity convergence is the more
      physically direct signal that the flow has settled; Density is
      also included but is constant here, so it's a no-op check).
      l2_norm (domain-averaged), not infinity_norm: the mesh has a
      handful of known degenerate sliver elements (see git history -
      edges down to ~0.15mm vs the 20mm MinimumEdgeLengths floor) that
      could keep a worst-point infinity_norm check from ever settling
      due to localized numerical noise at those elements, without that
      reflecting the bulk flow's actual state.
      acceleration_form (rate of change, not raw change) - NOT optional:
      a first attempt without it falsely declared "steady state" after
      the very first timestep (t=0.02s, Velocity still ~0.007 m/s),
      because the inlet's smootherstep ramp has zero slope at t=0, so
      the raw step-to-step change looked negligible before the flow had
      done anything. The ramp's rate of change (d/dt of 3t^2-2t^3 =
      6t(1-t)) grows from zero instead of shrinking toward it, so this
      doesn't misfire the same way. Caveat not yet empirically checked:
      the same derivative is ALSO zero at t=ramp_t=1.0s (smootherstep is
      flat at both ends by construction) - if the bulk domain's own rate
      of change happens to be small at exactly that moment too, this
      could in principle still false-trigger there; watching for that on
      the next run.
      Tolerance 0.013 (m/s per unit time here, under acceleration_form)
      ~ 1% of the inlet mean velocity (1.308 m/s) - a reasonable "no
      more meaningful change" threshold, not independently validated
      against this case's actual noise floor.
    -->
    <steady_state>
      <tolerance>
        <real_value rank="0">0.013</real_value>
        <l2_norm/>
      </tolerance>
      <acceleration_form/>
    </steady_state>
  </timestepping>
  <physical_parameters/>
  <material_phase name="FuelSalt">
    <!--
      Thermophysical properties at the 675 degC mean core temperature,
      sourced from Fang et al. (2024), Nucl. Eng. Des. 424, 113294, Table 1.
    -->
    <equation_of_state>
      <fluids>
        <linear>
          <reference_density>
            <real_value rank="0">4147.29</real_value>
          </reference_density>
        </linear>
      </fluids>
    </equation_of_state>
    <!--
      Same k-epsilon setup as the validated 3D case
      (msfr_wedge_real_tet.flml), reduced to 2D tensor/vector shapes.
      See that file's comments for the full reasoning (model constants
      and structure from Fluidity's own backward_facing_step_2d.flml
      example; BackgroundViscosity confirmed dynamic via
      parameterisation/k_epsilon.F90; theta=1.0 backward Euler instead
      of the example's 0.5 Crank-Nicolson, since 0.5 caused
      TurbulentDissipation to blow up to ~1e6 and go negative within 6
      timesteps on the 3D case; inlet k/epsilon from a standard
      5%-turbulence-intensity engineering estimate).

      BackgroundViscosity below uses a clean diagonal 2x2 (val,0,0,val),
      not literally copying backward_facing_step_2d.flml's own
      BackgroundViscosity value ("1.74e-5 1.74e-5 1.74e-5 1.74e-5" - all
      four entries equal, not diagonal), which looks like an oversight in
      that shipped example rather than something to replicate: an
      isotropic background viscosity should have zero off-diagonal terms,
      matching our verified-working 3D case's diagonal 3x3 pattern.
    -->
    <!--
      k-epsilon REMOVED (2D sanity check for LES/WALE, approved after the
      theta fix + Pressure/MinimumEdgeLengths recalibration still failed
      to stop the EddyViscosity/Pressure runaway - see git history on
      this line for the full k-epsilon block and its fix attempts).
      Replaced by les_model/wale on Velocity below: WALE is a zero-
      equation (algebraic) closure, computed fresh each timestep from
      the instantaneous local strain rate and mesh size - no transport
      equations, no time-integrated k^2/epsilon-style feedback, so it
      cannot reproduce the same unbounded blow-up mechanism.
      Caveat (discussed with user before implementing): this is NOT
      genuine LES. Real LES's sub-grid model approximates energy drained
      from resolved to unresolved scales via vortex stretching, which is
      a 3D-only mechanism (it vanishes identically in 2D flow, where
      vorticity is a scalar with no vector to stretch). Here WALE is
      used purely as a bounded, stable algebraic eddy-viscosity closure
      to sanity-check whether removing k-epsilon's feedback loop fixes
      the instability, before committing to the much larger 3D
      wall-resolved-mesh undertaking that genuine LES would require.
    -->
    <scalar_field rank="0" name="Pressure">
      <prognostic>
        <mesh name="PressureMesh"/>
        <spatial_discretisation>
          <continuous_galerkin/>
        </spatial_discretisation>
        <scheme>
          <poisson_pressure_solution>
            <string_value lines="1">only first timestep</string_value>
          </poisson_pressure_solution>
          <use_projection_method/>
        </scheme>
        <solver>
          <iterative_method name="cg"/>
          <preconditioner name="mg"/>
          <relative_error>
            <real_value rank="0">1.0e-6</real_value>
          </relative_error>
          <max_iterations>
            <integer_value rank="0">1000</integer_value>
          </max_iterations>
          <never_ignore_solver_failures/>
          <diagnostics>
            <monitors/>
          </diagnostics>
        </solver>
        <boundary_conditions name="Outlet">
          <surface_ids>
            <integer_value rank="1" shape="1">2</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <constant>
              <real_value rank="0">0.0</real_value>
            </constant>
          </type>
        </boundary_conditions>
        <output/>
        <stat/>
        <convergence>
          <include_in_convergence/>
        </convergence>
        <detectors>
          <exclude_from_detectors/>
        </detectors>
        <particles>
          <exclude_from_particles/>
        </particles>
        <steady_state>
          <exclude_from_steady_state/>
        </steady_state>
        <adaptivity_options>
          <absolute_measure>
            <scalar_field rank="0" name="InterpolationErrorBound">
              <prescribed>
                <value name="WholeMesh">
                  <constant>
                    <!--
                      Recalibrated off the dynamic-pressure scale
                      0.5*rho*U^2 for this case (rho=4147 kg/m3,
                      U~1.3-2.6 m/s accounting for local speed-up in
                      the bend -> scale ~3500-14000 Pa), replacing the
                      stale 0.04 Pa placeholder copied from the
                      flow_past_sphere_Re1000 example. 0.04 Pa against
                      a multi-thousand-Pa field is a ~1e-8 relative
                      tolerance, which was forcing near-uniform
                      maximum refinement everywhere regardless of
                      where real flow features were. 150 Pa is ~1-4%
                      of the dynamic-pressure scale; revisit once a
                      clean (post k-epsilon-fix) run shows the
                      converged pressure range directly.
                    -->
                    <real_value rank="0">150.0</real_value>
                  </constant>
                </value>
                <output/>
                <stat/>
                <detectors>
                  <exclude_from_detectors/>
                </detectors>
                <particles>
                  <exclude_from_particles/>
                </particles>
              </prescribed>
            </scalar_field>
          </absolute_measure>
        </adaptivity_options>
        <no_interpolation/>
      </prognostic>
    </scalar_field>
    <scalar_field rank="0" name="Density">
      <diagnostic>
        <algorithm name="Internal" material_phase_support="multiple"/>
        <mesh name="VelocityMesh"/>
        <output/>
        <stat/>
        <convergence>
          <include_in_convergence/>
        </convergence>
        <detectors>
          <include_in_detectors/>
        </detectors>
        <particles>
          <exclude_from_particles/>
        </particles>
        <steady_state>
          <include_in_steady_state/>
        </steady_state>
      </diagnostic>
    </scalar_field>
    <vector_field rank="1" name="Velocity">
      <prognostic>
        <mesh name="VelocityMesh"/>
        <equation name="LinearMomentum"/>
        <spatial_discretisation>
          <continuous_galerkin>
            <stabilisation>
              <streamline_upwind_petrov_galerkin>
                <nu_bar_optimal/>
                <nu_scale name="0.5">
                  <real_value rank="0" shape="1">0.5</real_value>
                </nu_scale>
              </streamline_upwind_petrov_galerkin>
            </stabilisation>
            <mass_terms>
              <lump_mass_matrix/>
            </mass_terms>
            <advection_terms/>
            <stress_terms>
              <partial_stress_form/>
            </stress_terms>
            <!--
              WALE sub-grid closure replacing k-epsilon - see the comment
              where k-epsilon used to be, above the Pressure field, for
              why. smagorinsky_coefficient 0.1 is the schema's suggested
              default (not separately tuned/validated here).
            -->
            <les_model>
              <wale>
                <smagorinsky_coefficient>
                  <real_value rank="0">0.1</real_value>
                </smagorinsky_coefficient>
              </wale>
            </les_model>
          </continuous_galerkin>
          <conservative_advection>
            <real_value rank="0">0.0</real_value>
          </conservative_advection>
        </spatial_discretisation>
        <temporal_discretisation>
          <theta>
            <real_value rank="0">0.5</real_value>
          </theta>
          <relaxation>
            <real_value rank="0">0.5</real_value>
          </relaxation>
        </temporal_discretisation>
        <solver>
          <iterative_method name="gmres">
            <restart>
              <integer_value rank="0">30</integer_value>
            </restart>
          </iterative_method>
          <preconditioner name="sor"/>
          <relative_error>
            <real_value rank="0">1.0e-6</real_value>
          </relative_error>
          <max_iterations>
            <integer_value rank="0">1000</integer_value>
          </max_iterations>
          <never_ignore_solver_failures/>
          <diagnostics>
            <monitors/>
          </diagnostics>
        </solver>
        <initial_condition name="WholeMesh">
          <constant>
            <real_value rank="1" dim1="dim" shape="2">0 0</real_value>
          </constant>
        </initial_condition>
        <!--
          Inlet (surface_id 1): same reasoning as the 3D case - uniform
          inflow along the local outward face normal, ramped smoothly
          from 0 to 1.308 m/s (Fang et al. 2024, sourced) over 1.0s to
          avoid the impulsive-start CFL shock found there. Sign:
          Fluidity's surface normal is outward-pointing, so inflow is
          negative - unconfirmed assumption, check first VTU dump.
        -->
        <boundary_conditions name="Inlet">
          <surface_ids>
            <integer_value rank="1" shape="1">1</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <align_bc_with_surface>
              <!--
                Parabolic profile, not flat/uniform: the literature this
                case is built from (idaholab/virtual_test_bed MSFR
                Nek5000 CFD model - same source as msfr_v2.geo) imposes
                a parabolic velocity profile at the inlet face, not a
                flat one (confirmed across the Virtual Test Bed MSFR
                Nek5000 page, its OSTI report, and the MSFR turbulence-
                tuning page). 2D planar Poiseuille: u(x) =
                1.5*u_mean*(1-((x-x_c)/R)^2), so the centreline peak is
                1.5x the mean and it goes to zero at the duct walls (mean
                over the profile is preserved at u_mean=1.308 m/s). x_c
                and R measured directly from this file's own inlet
                boundary (BoundaryID==1 line in
                msfr_wedge_midplane_2d_remeshed_geometry.vtu): x in
                [1.905603, 2.140603], width 0.235 m - matching the
                dh_inlet=0.235m already used for this case's k-epsilon
                length-scale estimate, so this is the same inlet channel,
                not a different value.
              -->
              <normal_component>
                <python>
                  <string_value type="code" language="python" lines="20">def val(X, t):
  u_mean = 1.308
  ramp_t = 1.0
  frac = min(1.0, t / ramp_t)
  s = frac * frac * (3.0 - 2.0 * frac)  # smootherstep: zero slope at t=0
  x_c = 2.02310323
  R = 0.1175
  xi = (X[0] - x_c) / R
  xi = max(-1.0, min(1.0, xi))
  parabolic = 1.5 * u_mean * (1.0 - xi * xi)
  return -parabolic * s</string_value>
                </python>
              </normal_component>
              <tangent_component_1>
                <constant>
                  <real_value rank="0">0.0</real_value>
                </constant>
              </tangent_component_1>
            </align_bc_with_surface>
          </type>
        </boundary_conditions>
        <!--
          Outlet (surface_id 2): no velocity BC - standard Fluidity
          "pressure outlet" pattern, matching the 3D case.
        -->
        <boundary_conditions name="Walls">
          <surface_ids>
            <integer_value rank="1" shape="1">3</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <align_bc_with_cartesian>
              <x_component>
                <constant>
                  <real_value rank="0">0.0</real_value>
                </constant>
              </x_component>
              <y_component>
                <constant>
                  <real_value rank="0">0.0</real_value>
                </constant>
              </y_component>
            </align_bc_with_cartesian>
          </type>
        </boundary_conditions>
        <!--
          Axis (surface_id 4): where this flat 2D slice meets the
          reactor's central axis (r=0) - real fluid-filled region in the
          3D geometry (the core bulk flow passes through the centreline),
          not a solid wall, so no-slip would be wrong. no_normal_flow
          (free-slip) matches standard axisymmetric-centreline practice,
          even though this is a flat domain, not a true axisymmetric
          formulation - a reasonable approximation for a fast test case,
          not claimed as exact.
        -->
        <boundary_conditions name="Axis">
          <surface_ids>
            <integer_value rank="1" shape="1">4</integer_value>
          </surface_ids>
          <type name="no_normal_flow"/>
        </boundary_conditions>
        <!--
          Switched from diagnostic/Internal (which combined k-epsilon's
          separately-tracked BackgroundViscosity+EddyViscosity fields,
          now removed) to PRESCRIBED molecular viscosity directly: LES's
          sub-grid stress is computed and added by Momentum_CG.F90's own
          assembly (les_viscosity_strength/wale_viscosity_strength),
          using this field as the molecular/laminar viscosity input to
          that calculation, not through the k-epsilon-style diagnostic
          combination. Same value as the old BackgroundViscosity
          (0.011266 Pa.s, molten salt dynamic viscosity at 675 degC,
          Fang et al. 2024).
        -->
        <tensor_field name="Viscosity" rank="2">
          <prescribed>
            <mesh name="VelocityMesh"/>
            <value name="WholeMesh">
              <anisotropic_symmetric>
                <constant>
                  <real_value symmetric="true" rank="2" dim1="dim" dim2="dim" shape="2 2">0.011266 0.0 0.0 0.011266</real_value>
                </constant>
              </anisotropic_symmetric>
            </value>
            <output/>
            <particles>
              <exclude_from_particles/>
            </particles>
          </prescribed>
        </tensor_field>
        <output/>
        <stat>
          <include_in_stat/>
          <previous_time_step>
            <exclude_from_stat/>
          </previous_time_step>
          <nonlinear_field>
            <exclude_from_stat/>
          </nonlinear_field>
        </stat>
        <convergence>
          <include_in_convergence/>
        </convergence>
        <detectors>
          <include_in_detectors/>
        </detectors>
        <particles>
          <exclude_from_particles/>
        </particles>
        <steady_state>
          <include_in_steady_state/>
        </steady_state>
        <adaptivity_options>
          <absolute_measure>
            <vector_field rank="1" name="InterpolationErrorBound">
              <prescribed>
                <value name="WholeMesh">
                  <constant>
                    <real_value rank="1" dim1="dim" shape="2">0.05 0.05</real_value>
                  </constant>
                </value>
                <output/>
                <stat>
                  <include_in_stat/>
                </stat>
                <detectors>
                  <exclude_from_detectors/>
                </detectors>
                <particles>
                  <exclude_from_particles/>
                </particles>
              </prescribed>
            </vector_field>
          </absolute_measure>
        </adaptivity_options>
        <consistent_interpolation/>
      </prognostic>
    </vector_field>
    <scalar_field rank="0" name="CFLNumber">
      <diagnostic>
        <algorithm name="Internal" material_phase_support="multiple"/>
        <mesh name="VelocityMesh"/>
        <output/>
        <stat/>
        <convergence>
          <include_in_convergence/>
        </convergence>
        <detectors>
          <include_in_detectors/>
        </detectors>
        <particles>
          <exclude_from_particles/>
        </particles>
        <steady_state>
          <exclude_from_steady_state/>
        </steady_state>
      </diagnostic>
    </scalar_field>
  </material_phase>
  <mesh_adaptivity>
    <hr_adaptivity>
      <period_in_timesteps>
        <integer_value rank="0">25</integer_value>
      </period_in_timesteps>
      <maximum_number_of_nodes>
        <integer_value rank="0">2000000</integer_value>
      </maximum_number_of_nodes>
      <enable_gradation>
        <gradation_parameter>
          <real_value rank="0">1.3</real_value>
        </gradation_parameter>
      </enable_gradation>
      <tensor_field name="MinimumEdgeLengths">
        <anisotropic_symmetric>
          <constant>
            <!--
              Loosened from 0.01 m: with the Pressure
              InterpolationErrorBound fix and the k-epsilon source-term
              theta fix, the mesh should no longer need to sit at the
              minimum almost everywhere just to chase a spuriously
              growing field. 0.02 m directly cuts element count/cost
              where real flow features don't demand finer resolution.
            -->
            <real_value symmetric="true" rank="2" dim1="dim" dim2="dim" shape="2 2">0.02 0.0 0.0 0.02</real_value>
          </constant>
        </anisotropic_symmetric>
      </tensor_field>
      <tensor_field name="MaximumEdgeLengths">
        <anisotropic_symmetric>
          <constant>
            <real_value symmetric="true" rank="2" dim1="dim" dim2="dim" shape="2 2">0.3 0.0 0.0 0.3</real_value>
          </constant>
        </anisotropic_symmetric>
      </tensor_field>
      <!--
        No adapt_at_first_timestep, same reasoning as the 3D case: it
        forces adapts on the still-zero initial Velocity field, which is
        degenerate for Hessian-based metric formation and over-coarsens
        the mesh before flow develops.
      -->
      <zoltan_options>
        <load_imbalance_tolerance>
          <real_value rank="0">1.1</real_value>
        </load_imbalance_tolerance>
      </zoltan_options>
      <adapt_iterations>
        <integer_value rank="0">4</integer_value>
      </adapt_iterations>
    </hr_adaptivity>
  </mesh_adaptivity>
</fluidity_options>
