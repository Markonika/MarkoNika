<?xml version='1.0' encoding='utf-8'?>
<fluidity_options>
  <simulation_name>
    <string_value lines="1">msfr_wedge_real_tet</string_value>
  </simulation_name>
  <problem_type>
    <string_value lines="1">fluids</string_value>
  </problem_type>
  <geometry>
    <dimension>
      <integer_value rank="0">3</integer_value>
    </dimension>
    <mesh name="CoordinateMesh">
      <from_file file_name="msfr_wedge_real_tet">
        <format name="gmsh"/>
        <stat>
          <include_in_stat/>
        </stat>
      </from_file>
    </mesh>
    <mesh name="VelocityMesh">
      <from_mesh>
        <mesh name="CoordinateMesh"/>
        <stat>
          <exclude_from_stat/>
        </stat>
      </from_mesh>
    </mesh>
    <mesh name="PressureMesh">
      <from_mesh>
        <mesh name="CoordinateMesh"/>
        <stat>
          <exclude_from_stat/>
        </stat>
      </from_mesh>
    </mesh>
    <quadrature>
      <degree>
        <integer_value rank="0">3</integer_value>
      </degree>
    </quadrature>
  </geometry>
  <io>
    <dump_format>
      <string_value>vtk</string_value>
    </dump_format>
    <dump_period>
      <constant>
        <real_value rank="0">1.0</real_value>
      </constant>
    </dump_period>
    <output_mesh name="VelocityMesh"/>
    <checkpointing>
      <checkpoint_period_in_dumps>
        <integer_value rank="0">5</integer_value>
      </checkpoint_period_in_dumps>
    </checkpointing>
    <stat/>
  </io>
  <timestepping>
    <current_time>
      <real_value rank="0">0</real_value>
    </current_time>
    <timestep>
      <real_value rank="0">0.02</real_value>
    </timestep>
    <finish_time>
      <real_value rank="0">20.0</real_value>
    </finish_time>
    <nonlinear_iterations>
      <integer_value rank="0">2</integer_value>
    </nonlinear_iterations>
    <!--
      Adaptive (CFL-limited) timestep rather than v2's fixed dt=0.02: the
      earlier hex-wedge wedge case (msfr_wedge_v2.flml) diverged around
      t~2.9-3.0s with a fixed 0.02s step, and an over-large fixed step was
      a suspected contributing cause (never isolated, since the geometry
      correction took priority). Capping by Courant number is a more
      robust default for a first attempt on this new mesh.
    -->
    <adaptive_timestep>
      <requested_cfl>
        <real_value rank="0">3.0</real_value>
      </requested_cfl>
      <courant_number name="CFLNumber">
        <mesh name="VelocityMesh"/>
      </courant_number>
      <maximum_timestep>
        <real_value rank="0">0.1</real_value>
      </maximum_timestep>
      <increase_tolerance>
        <real_value rank="0">1.2</real_value>
      </increase_tolerance>
    </adaptive_timestep>
  </timestepping>
  <physical_parameters/>
  <material_phase name="FuelSalt">
    <!--
      Thermophysical properties at the 675 degC mean core temperature,
      sourced from Fang et al. (2024), Nucl. Eng. Des. 424, 113294, Table 1.
    -->
    <equation_of_state>
      <fluids>
        <linear>
          <reference_density>
            <real_value rank="0">4147.29</real_value>
          </reference_density>
        </linear>
      </fluids>
    </equation_of_state>
    <!--
      Standard k-epsilon RANS closure (Ferziger and Peric 2002 p.295),
      replacing the earlier flat placeholder viscosity. Structure and
      model constants (C_mu, C_eps_1, C_eps_2, sigma_k, sigma_eps,
      sigma_p) follow Fluidity's own worked example,
      examples/backward_facing_step_2d/backward_facing_step_2d.flml -
      these are the standard literature values, not case-specific.

      BackgroundViscosity below is confirmed DYNAMIC viscosity (Pa.s),
      not kinematic: parameterisation/k_epsilon.F90's low-Re damping
      functions compute R_y = density*sqrt(k)*y/bg_visc, which is only
      dimensionless if bg_visc is dynamic. With a turbulence model now
      handling the turbulent diffusion, Velocity's own Viscosity field
      (further down) switches from the old flat placeholder to a
      DIAGNOSTIC field combining this molecular value with the computed
      EddyViscosity - so we can finally use the TRUE molecular
      viscosity (0.011266 Pa.s, Fang et al. 2024 Table 1, true Re~1.02e6)
      instead of the old artificially-inflated Re=40,000 placeholder.

      Near-wall treatment: low-Re damping (enable_lowRe_damping, which
      needs a DistanceToWall field) is NOT enabled here, matching the
      worked example - standard high-Re k-epsilon with the implicit
      log-law assumption. Worth revisiting once near-wall mesh resolution
      is assessed post-adaptivity; not done now to stay close to the one
      validated template available.

      Inlet k/epsilon values are a standard engineering estimate (NOT
      measured or literature-sourced for this reactor), from assumed 5%
      turbulence intensity I and a length scale l=0.07*D_h using the real
      inlet channel width dh_inlet=0.235 m (idaholab/virtual_test_bed
      msfr_v2.geo) as D_h:
        k = 1.5*(I*U)^2 = 1.5*(0.05*1.308)^2 = 0.006416 m^2/s^2
        l = 0.07*0.235 = 0.01645 m
        epsilon = C_mu^0.75 * k^1.5 / l = 0.005133 m^2/s^3
    -->
    <subgridscale_parameterisations>
      <k-epsilon>
        <scalar_field rank="0" name="TurbulentKineticEnergy">
          <prognostic>
            <mesh name="VelocityMesh"/>
            <equation name="KEpsilon">
              <density name="Density">
                <discretisation_options>
                  <spatial_discretisation>
                    <control_volumes>
                      <face_value name="FirstOrderUpwind"/>
                    </control_volumes>
                  </spatial_discretisation>
                  <temporal_discretisation>
                    <theta>
                      <real_value rank="0">1.0</real_value>
                    </theta>
                    <control_volumes/>
                  </temporal_discretisation>
                </discretisation_options>
              </density>
            </equation>
            <spatial_discretisation>
              <control_volumes>
                <face_value name="FirstOrderUpwind"/>
                <diffusion_scheme name="ElementGradient"/>
              </control_volumes>
              <conservative_advection>
                <real_value rank="0">0</real_value>
              </conservative_advection>
            </spatial_discretisation>
            <!--
              theta=1.0 (fully implicit backward Euler), not the 0.5
              Crank-Nicolson the worked example used: a direct test with
              0.5 blew up (TurbulentDissipation reaching ~1e6 and going
              negative to -1.3e6 within 6 timesteps, aborting the run) -
              Fluidity's k-epsilon only clips k/epsilon defensively
              INSIDE internal source-term/length-scale formulas
              (parameterisation/k_epsilon.F90), not on the solved field
              itself, so a Crank-Nicolson-level of implicitness wasn't
              enough to keep the stiff production/destruction source
              terms bounded on this case's real (much lower, no longer
              artificially inflated) molecular viscosity. Backward Euler
              is the standard first remedy for this failure mode.
            -->
            <temporal_discretisation>
              <theta>
                <real_value rank="0">1.0</real_value>
              </theta>
            </temporal_discretisation>
            <solver>
              <iterative_method name="gmres">
                <restart>
                  <integer_value rank="0">30</integer_value>
                </restart>
              </iterative_method>
              <preconditioner name="sor"/>
              <relative_error>
                <real_value rank="0">1.e-7</real_value>
              </relative_error>
              <max_iterations>
                <integer_value rank="0">1000</integer_value>
              </max_iterations>
              <never_ignore_solver_failures/>
              <diagnostics>
                <monitors/>
              </diagnostics>
            </solver>
            <initial_condition name="WholeMesh">
              <constant>
                <real_value rank="0">0.006416</real_value>
              </constant>
            </initial_condition>
            <boundary_conditions name="Inlet">
              <surface_ids>
                <integer_value rank="1" shape="1">1</integer_value>
              </surface_ids>
              <type name="dirichlet">
                <constant>
                  <real_value rank="0">0.006416</real_value>
                </constant>
              </type>
            </boundary_conditions>
            <tensor_field name="Diffusivity" rank="2">
              <diagnostic>
                <algorithm name="Internal" material_phase_support="multiple"/>
                <output/>
                <stat>
                  <exclude_from_stat/>
                </stat>
                <particles>
                  <exclude_from_particles/>
                </particles>
              </diagnostic>
            </tensor_field>
            <scalar_field name="Source" rank="0">
              <diagnostic>
                <algorithm name="Internal" material_phase_support="multiple"/>
                <output/>
                <stat/>
                <detectors>
                  <include_in_detectors/>
                </detectors>
                <particles>
                  <exclude_from_particles/>
                </particles>
              </diagnostic>
            </scalar_field>
            <scalar_field name="Absorption" rank="0">
              <diagnostic>
                <algorithm name="Internal" material_phase_support="multiple"/>
                <output/>
                <stat/>
                <detectors>
                  <include_in_detectors/>
                </detectors>
                <particles>
                  <exclude_from_particles/>
                </particles>
              </diagnostic>
            </scalar_field>
            <output/>
            <stat/>
            <convergence>
              <include_in_convergence/>
            </convergence>
            <detectors>
              <include_in_detectors/>
            </detectors>
            <particles>
              <exclude_from_particles/>
            </particles>
            <steady_state>
              <include_in_steady_state/>
            </steady_state>
            <consistent_interpolation/>
          </prognostic>
        </scalar_field>
        <scalar_field rank="0" name="TurbulentDissipation">
          <prognostic>
            <mesh name="VelocityMesh"/>
            <equation name="KEpsilon">
              <density name="Density">
                <discretisation_options>
                  <spatial_discretisation>
                    <control_volumes>
                      <face_value name="FirstOrderUpwind"/>
                    </control_volumes>
                  </spatial_discretisation>
                  <temporal_discretisation>
                    <theta>
                      <real_value rank="0">1.0</real_value>
                    </theta>
                    <control_volumes/>
                  </temporal_discretisation>
                </discretisation_options>
              </density>
            </equation>
            <spatial_discretisation>
              <control_volumes>
                <face_value name="FirstOrderUpwind"/>
                <diffusion_scheme name="ElementGradient"/>
              </control_volumes>
              <conservative_advection>
                <real_value rank="0">0</real_value>
              </conservative_advection>
            </spatial_discretisation>
            <!--
              theta=1.0 (fully implicit backward Euler), not the 0.5
              Crank-Nicolson the worked example used: a direct test with
              0.5 blew up (TurbulentDissipation reaching ~1e6 and going
              negative to -1.3e6 within 6 timesteps, aborting the run) -
              Fluidity's k-epsilon only clips k/epsilon defensively
              INSIDE internal source-term/length-scale formulas
              (parameterisation/k_epsilon.F90), not on the solved field
              itself, so a Crank-Nicolson-level of implicitness wasn't
              enough to keep the stiff production/destruction source
              terms bounded on this case's real (much lower, no longer
              artificially inflated) molecular viscosity. Backward Euler
              is the standard first remedy for this failure mode.
            -->
            <temporal_discretisation>
              <theta>
                <real_value rank="0">1.0</real_value>
              </theta>
            </temporal_discretisation>
            <solver>
              <iterative_method name="gmres">
                <restart>
                  <integer_value rank="0">30</integer_value>
                </restart>
              </iterative_method>
              <preconditioner name="sor"/>
              <relative_error>
                <real_value rank="0">1.e-7</real_value>
              </relative_error>
              <max_iterations>
                <integer_value rank="0">1000</integer_value>
              </max_iterations>
              <never_ignore_solver_failures/>
              <diagnostics>
                <monitors/>
              </diagnostics>
            </solver>
            <initial_condition name="WholeMesh">
              <constant>
                <real_value rank="0">0.005133</real_value>
              </constant>
            </initial_condition>
            <boundary_conditions name="Inlet">
              <surface_ids>
                <integer_value rank="1" shape="1">1</integer_value>
              </surface_ids>
              <type name="dirichlet">
                <constant>
                  <real_value rank="0">0.005133</real_value>
                </constant>
              </type>
            </boundary_conditions>
            <tensor_field name="Diffusivity" rank="2">
              <diagnostic>
                <algorithm name="Internal" material_phase_support="multiple"/>
                <output/>
                <stat>
                  <exclude_from_stat/>
                </stat>
                <particles>
                  <exclude_from_particles/>
                </particles>
              </diagnostic>
            </tensor_field>
            <scalar_field name="Source" rank="0">
              <diagnostic>
                <algorithm name="Internal" material_phase_support="multiple"/>
                <output/>
                <stat/>
                <detectors>
                  <include_in_detectors/>
                </detectors>
                <particles>
                  <exclude_from_particles/>
                </particles>
              </diagnostic>
            </scalar_field>
            <scalar_field name="Absorption" rank="0">
              <diagnostic>
                <algorithm name="Internal" material_phase_support="multiple"/>
                <output/>
                <stat/>
                <detectors>
                  <include_in_detectors/>
                </detectors>
                <particles>
                  <exclude_from_particles/>
                </particles>
              </diagnostic>
            </scalar_field>
            <output/>
            <stat/>
            <convergence>
              <include_in_convergence/>
            </convergence>
            <detectors>
              <include_in_detectors/>
            </detectors>
            <particles>
              <exclude_from_particles/>
            </particles>
            <steady_state>
              <include_in_steady_state/>
            </steady_state>
            <consistent_interpolation/>
          </prognostic>
        </scalar_field>
        <tensor_field rank="2" name="BackgroundViscosity">
          <prescribed>
            <mesh name="VelocityMesh"/>
            <value name="WholeMesh">
              <anisotropic_symmetric>
                <constant>
                  <real_value symmetric="true" rank="2" dim1="dim" dim2="dim" shape="3 3">0.011266 0.0 0.0 0.0 0.011266 0.0 0.0 0.0 0.011266</real_value>
                </constant>
              </anisotropic_symmetric>
            </value>
            <output/>
            <particles>
              <exclude_from_particles/>
            </particles>
          </prescribed>
        </tensor_field>
        <tensor_field rank="2" name="EddyViscosity">
          <diagnostic>
            <algorithm name="Internal" material_phase_support="multiple"/>
            <mesh name="VelocityMesh"/>
            <output/>
            <stat>
              <exclude_from_stat/>
            </stat>
            <particles>
              <exclude_from_particles/>
            </particles>
          </diagnostic>
        </tensor_field>
        <scalar_field rank="0" name="ScalarEddyViscosity">
          <diagnostic>
            <algorithm name="Internal" material_phase_support="multiple"/>
            <mesh name="VelocityMesh"/>
            <output/>
            <stat/>
            <convergence>
              <include_in_convergence/>
            </convergence>
            <detectors>
              <include_in_detectors/>
            </detectors>
            <particles>
              <exclude_from_particles/>
            </particles>
            <steady_state>
              <include_in_steady_state/>
            </steady_state>
          </diagnostic>
        </scalar_field>
        <scalar_field rank="0" name="LengthScale">
          <diagnostic>
            <algorithm name="Internal" material_phase_support="multiple"/>
            <mesh name="VelocityMesh"/>
            <output/>
            <stat/>
            <convergence>
              <include_in_convergence/>
            </convergence>
            <detectors>
              <include_in_detectors/>
            </detectors>
            <particles>
              <exclude_from_particles/>
            </particles>
            <steady_state>
              <include_in_steady_state/>
            </steady_state>
          </diagnostic>
        </scalar_field>
        <scalar_field rank="0" name="f_1">
          <diagnostic>
            <algorithm name="Internal" material_phase_support="multiple"/>
            <mesh name="VelocityMesh"/>
            <output/>
            <stat/>
            <convergence>
              <include_in_convergence/>
            </convergence>
            <detectors>
              <include_in_detectors/>
            </detectors>
            <particles>
              <exclude_from_particles/>
            </particles>
            <steady_state>
              <include_in_steady_state/>
            </steady_state>
          </diagnostic>
        </scalar_field>
        <scalar_field rank="0" name="f_2">
          <diagnostic>
            <algorithm name="Internal" material_phase_support="multiple"/>
            <mesh name="VelocityMesh"/>
            <output/>
            <stat/>
            <convergence>
              <include_in_convergence/>
            </convergence>
            <detectors>
              <include_in_detectors/>
            </detectors>
            <particles>
              <exclude_from_particles/>
            </particles>
            <steady_state>
              <include_in_steady_state/>
            </steady_state>
          </diagnostic>
        </scalar_field>
        <scalar_field rank="0" name="f_mu">
          <diagnostic>
            <algorithm name="Internal" material_phase_support="multiple"/>
            <mesh name="VelocityMesh"/>
            <output/>
            <stat/>
            <convergence>
              <include_in_convergence/>
            </convergence>
            <detectors>
              <include_in_detectors/>
            </detectors>
            <particles>
              <exclude_from_particles/>
            </particles>
            <steady_state>
              <include_in_steady_state/>
            </steady_state>
          </diagnostic>
        </scalar_field>
        <max_damping_value>
          <real_value rank="0">10.0</real_value>
        </max_damping_value>
        <C_mu>
          <real_value rank="0">.09</real_value>
        </C_mu>
        <C_eps_1>
          <real_value rank="0">1.44</real_value>
        </C_eps_1>
        <C_eps_2>
          <real_value rank="0">1.92</real_value>
        </C_eps_2>
        <sigma_k>
          <real_value rank="0">1</real_value>
        </sigma_k>
        <sigma_eps>
          <real_value rank="0">1.3</real_value>
        </sigma_eps>
        <sigma_p>
          <real_value rank="0">1.0</real_value>
        </sigma_p>
        <time_discretisation>
          <theta>
            <real_value rank="0">0.5</real_value>
          </theta>
          <source_term_implementation>
            <production_term>source</production_term>
            <destruction_term>absorbtion</destruction_term>
            <buoyancy_term>source</buoyancy_term>
          </source_term_implementation>
        </time_discretisation>
        <mass_terms>
          <lump_mass/>
        </mass_terms>
      </k-epsilon>
    </subgridscale_parameterisations>
    <scalar_field rank="0" name="Pressure">
      <prognostic>
        <mesh name="PressureMesh"/>
        <spatial_discretisation>
          <continuous_galerkin/>
        </spatial_discretisation>
        <scheme>
          <poisson_pressure_solution>
            <string_value lines="1">only first timestep</string_value>
          </poisson_pressure_solution>
          <use_projection_method/>
        </scheme>
        <solver>
          <iterative_method name="cg"/>
          <preconditioner name="mg"/>
          <relative_error>
            <real_value rank="0">1.0e-6</real_value>
          </relative_error>
          <max_iterations>
            <integer_value rank="0">1000</integer_value>
          </max_iterations>
          <never_ignore_solver_failures/>
          <diagnostics>
            <monitors/>
          </diagnostics>
        </solver>
        <boundary_conditions name="Outlet">
          <surface_ids>
            <integer_value rank="1" shape="1">2</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <constant>
              <real_value rank="0">0.0</real_value>
            </constant>
          </type>
        </boundary_conditions>
        <output/>
        <stat/>
        <convergence>
          <include_in_convergence/>
        </convergence>
        <detectors>
          <exclude_from_detectors/>
        </detectors>
        <particles>
          <exclude_from_particles/>
        </particles>
        <steady_state>
          <exclude_from_steady_state/>
        </steady_state>
        <adaptivity_options>
          <absolute_measure>
            <scalar_field rank="0" name="InterpolationErrorBound">
              <prescribed>
                <value name="WholeMesh">
                  <constant>
                    <!--
                      PLACEHOLDER: order-of-magnitude guess (same value
                      used by the flow_past_sphere_Re1000 example this
                      adaptivity block is modelled on), not calibrated
                      against this case's actual pressure range - we
                      don't have a stable run yet to calibrate against.
                      Revisit once the first run completes.
                    -->
                    <real_value rank="0">0.04</real_value>
                  </constant>
                </value>
                <output/>
                <stat/>
                <detectors>
                  <exclude_from_detectors/>
                </detectors>
                <particles>
                  <exclude_from_particles/>
                </particles>
              </prescribed>
            </scalar_field>
          </absolute_measure>
        </adaptivity_options>
        <no_interpolation/>
      </prognostic>
    </scalar_field>
    <scalar_field rank="0" name="Density">
      <diagnostic>
        <algorithm name="Internal" material_phase_support="multiple"/>
        <mesh name="VelocityMesh"/>
        <output/>
        <stat/>
        <convergence>
          <include_in_convergence/>
        </convergence>
        <detectors>
          <include_in_detectors/>
        </detectors>
        <particles>
          <exclude_from_particles/>
        </particles>
        <steady_state>
          <include_in_steady_state/>
        </steady_state>
      </diagnostic>
    </scalar_field>
    <vector_field rank="1" name="Velocity">
      <prognostic>
        <mesh name="VelocityMesh"/>
        <equation name="LinearMomentum"/>
        <spatial_discretisation>
          <continuous_galerkin>
            <!--
              Switched from v2's no_stabilisation to SUPG: the earlier
              case's numerical divergence was suspected (not confirmed)
              to be partly a stabilisation/timestep issue, since
              no_stabilisation was copied unchanged from a laminar,
              finely-adapted 2D lid-driven-cavity template that isn't
              obviously appropriate for this coarser, faster, unstructured
              3D case.
            -->
            <stabilisation>
              <streamline_upwind_petrov_galerkin>
                <nu_bar_optimal/>
                <nu_scale name="0.5">
                  <real_value rank="0" shape="1">0.5</real_value>
                </nu_scale>
              </streamline_upwind_petrov_galerkin>
            </stabilisation>
            <mass_terms>
              <lump_mass_matrix/>
            </mass_terms>
            <advection_terms/>
            <!--
              partial_stress_form (not tensor_form): matches the pairing
              used by Fluidity's own worked k-epsilon example
              (backward_facing_step_2d.flml) - not independently
              re-derived, just following the one validated precedent
              available for this combination.
            -->
            <stress_terms>
              <partial_stress_form/>
            </stress_terms>
          </continuous_galerkin>
          <conservative_advection>
            <real_value rank="0">0.0</real_value>
          </conservative_advection>
        </spatial_discretisation>
        <temporal_discretisation>
          <theta>
            <real_value rank="0">0.5</real_value>
          </theta>
          <relaxation>
            <real_value rank="0">0.5</real_value>
          </relaxation>
        </temporal_discretisation>
        <solver>
          <iterative_method name="gmres">
            <restart>
              <integer_value rank="0">30</integer_value>
            </restart>
          </iterative_method>
          <preconditioner name="sor"/>
          <relative_error>
            <real_value rank="0">1.0e-6</real_value>
          </relative_error>
          <max_iterations>
            <integer_value rank="0">1000</integer_value>
          </max_iterations>
          <never_ignore_solver_failures/>
          <diagnostics>
            <monitors/>
          </diagnostics>
        </solver>
        <initial_condition name="WholeMesh">
          <constant>
            <real_value rank="1" dim1="dim" shape="3">0 0 0</real_value>
          </constant>
        </initial_condition>
        <!--
          Inlet (surface_id 1): the real neck->elbow->extrusion channel
          geometry (idaholab/virtual_test_bed msfr_v2.geo) is NOT a
          circular pipe, so v2's analytic Poiseuille-profile python
          functions (built around a known pipe axis and radius) no longer
          apply. Using align_bc_with_surface/normal_component instead:
          uniform inflow along the LOCAL outward face normal at every
          node, zero tangential components (no swirl/skew). This is a
          simpler, cruder inlet condition than v2's parabolic profile (no
          boundary-layer falloff at the channel walls), chosen because it
          needs no assumption about the channel's cross-sectional shape -
          reasonable given mesh adaptivity will reshape the near-inlet
          mesh after the first few iterations anyway.

          Magnitude 1.308 m/s = mean core-inlet velocity, Fang et al.
          (2024) Table 1 (SOURCED). Sign: Fluidity's surface normal
          convention is outward-pointing, so inflow (into the domain) is
          the NEGATIVE normal direction - this sign is an assumption,
          not yet confirmed against a run; check the first VTU dump shows
          flow actually entering (not leaving) at the inlet face, and
          flip the sign here if not.

          Ramped smoothly from 0 to full speed over RAMP_T=1.0s (smoother-
          step, zero initial slope) rather than a step/constant: a direct
          test of this case with a constant inlet BC hit a catastrophic
          first-timestep CFL spike (3.2e12 - the zero initial condition
          meeting a full-speed Dirichlet BC on one of this mesh's known
          lower-quality tets near the geometric-clip boundary), which the
          adaptive timestep then took hundreds of steps to recover from
          (forced dt down to ~1.9e-14s, climbing back at 1.2x/step). The
          ramp avoids that initial shock; mesh_adaptivity is expected to
          improve the worst elements away over the first few adapts, per
          the project's own plan, independent of this fix.
        -->
        <boundary_conditions name="Inlet">
          <surface_ids>
            <integer_value rank="1" shape="1">1</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <align_bc_with_surface>
              <normal_component>
                <python>
                  <string_value type="code" language="python" lines="20">def val(X, t):
  u_target = 1.308
  ramp_t = 1.0
  frac = min(1.0, t / ramp_t)
  s = frac * frac * (3.0 - 2.0 * frac)  # smootherstep: zero slope at t=0
  return -u_target * s</string_value>
                </python>
              </normal_component>
              <tangent_component_1>
                <constant>
                  <real_value rank="0">0.0</real_value>
                </constant>
              </tangent_component_1>
              <tangent_component_2>
                <constant>
                  <real_value rank="0">0.0</real_value>
                </constant>
              </tangent_component_2>
            </align_bc_with_surface>
          </type>
        </boundary_conditions>
        <!--
          Outlet (surface_id 2): no velocity BC here on purpose - this is
          the standard Fluidity "pressure outlet" pattern. Only the
          Pressure field's Dirichlet BC (above) fixes the outlet; the
          velocity is left free so the flow can leave the domain.
        -->
        <boundary_conditions name="Walls">
          <surface_ids>
            <integer_value rank="1" shape="1">3</integer_value>
          </surface_ids>
          <type name="dirichlet">
            <align_bc_with_cartesian>
              <x_component>
                <constant>
                  <real_value rank="0">0.0</real_value>
                </constant>
              </x_component>
              <y_component>
                <constant>
                  <real_value rank="0">0.0</real_value>
                </constant>
              </y_component>
              <z_component>
                <constant>
                  <real_value rank="0">0.0</real_value>
                </constant>
              </z_component>
            </align_bc_with_cartesian>
          </type>
        </boundary_conditions>
        <boundary_conditions name="SymmetryPlanes">
          <surface_ids>
            <integer_value rank="1" shape="2">4 5</integer_value>
          </surface_ids>
          <type name="no_normal_flow"/>
        </boundary_conditions>
        <!--
          Viscosity is now DIAGNOSTIC, not prescribed: with k-epsilon
          enabled above, Fluidity computes this internally by combining
          BackgroundViscosity (true molecular, 0.011266 Pa.s) with the
          turbulence model's own EddyViscosity, replacing the old flat
          placeholder (which targeted an artificial effective Re=40,000
          since there was no turbulence model to handle the real
          Re~1.02e6). That placeholder's full reasoning (including the
          Re=40,000 derivation against the archived INL VTB reference
          data) is preserved in git history on this line for anyone
          wanting to compare the two approaches.
        -->
        <tensor_field name="Viscosity" rank="2">
          <diagnostic>
            <algorithm name="Internal" material_phase_support="multiple"/>
            <output/>
            <stat>
              <include_in_stat/>
            </stat>
            <particles>
              <exclude_from_particles/>
            </particles>
          </diagnostic>
        </tensor_field>
        <output/>
        <stat>
          <include_in_stat/>
          <previous_time_step>
            <exclude_from_stat/>
          </previous_time_step>
          <nonlinear_field>
            <exclude_from_stat/>
          </nonlinear_field>
        </stat>
        <convergence>
          <include_in_convergence/>
        </convergence>
        <detectors>
          <include_in_detectors/>
        </detectors>
        <particles>
          <exclude_from_particles/>
        </particles>
        <steady_state>
          <include_in_steady_state/>
        </steady_state>
        <adaptivity_options>
          <absolute_measure>
            <vector_field rank="1" name="InterpolationErrorBound">
              <prescribed>
                <value name="WholeMesh">
                  <constant>
                    <!--
                      PLACEHOLDER: ~4% of the inlet speed, same reasoning
                      as the Pressure bound above - not calibrated yet.
                    -->
                    <real_value rank="1" dim1="dim" shape="3">0.05 0.05 0.05</real_value>
                  </constant>
                </value>
                <output/>
                <stat>
                  <include_in_stat/>
                </stat>
                <detectors>
                  <exclude_from_detectors/>
                </detectors>
                <particles>
                  <exclude_from_particles/>
                </particles>
              </prescribed>
            </vector_field>
          </absolute_measure>
        </adaptivity_options>
        <consistent_interpolation/>
      </prognostic>
    </vector_field>
    <scalar_field rank="0" name="CFLNumber">
      <diagnostic>
        <algorithm name="Internal" material_phase_support="multiple"/>
        <mesh name="VelocityMesh"/>
        <output/>
        <stat/>
        <convergence>
          <include_in_convergence/>
        </convergence>
        <detectors>
          <include_in_detectors/>
        </detectors>
        <particles>
          <exclude_from_particles/>
        </particles>
        <steady_state>
          <exclude_from_steady_state/>
        </steady_state>
      </diagnostic>
    </scalar_field>
  </material_phase>
  <mesh_adaptivity>
    <hr_adaptivity>
      <period_in_timesteps>
        <integer_value rank="0">25</integer_value>
      </period_in_timesteps>
      <maximum_number_of_nodes>
        <integer_value rank="0">2000000</integer_value>
      </maximum_number_of_nodes>
      <enable_gradation>
        <gradation_parameter>
          <real_value rank="0">1.3</real_value>
        </gradation_parameter>
      </enable_gradation>
      <!--
        Current fixed mesh resolves down to h_bl=0.025 m at walls (INL's
        boundary-layer spacing) with ~2.65 m domain extent. Min/max edge
        length bounds below let adaptivity both refine finer than that
        near shear layers and coarsen well beyond it in the bulk - not
        calibrated, a first guess to revisit once a run completes.
      -->
      <tensor_field name="MinimumEdgeLengths">
        <anisotropic_symmetric>
          <constant>
            <real_value symmetric="true" rank="2" dim1="dim" dim2="dim" shape="3 3">0.01 0.0 0.0 0.0 0.01 0.0 0.0 0.0 0.01</real_value>
          </constant>
        </anisotropic_symmetric>
      </tensor_field>
      <tensor_field name="MaximumEdgeLengths">
        <anisotropic_symmetric>
          <constant>
            <real_value symmetric="true" rank="2" dim1="dim" dim2="dim" shape="3 3">0.3 0.0 0.0 0.0 0.3 0.0 0.0 0.0 0.3</real_value>
          </constant>
        </anisotropic_symmetric>
      </tensor_field>
      <!--
        Deliberately NOT using adapt_at_first_timestep: it forces adapts
        before the first real timestep, while Velocity is still exactly
        the zero initial condition. Adapting on the Hessian of a uniform
        zero field is degenerate (no curvature anywhere), so the error
        metric pushes toward maximum coarsening everywhere - confirmed
        directly: with it enabled, the mesh collapsed from ~15,000 nodes
        to 727 (hitting MaximumEdgeLengths across the whole domain), the
        inlet patch was crushed from 500 triangles to 4, and Velocity
        stayed EXACTLY 0.0 at every point through the entire run (verified
        in VTU dumps out to t=20) - the flow never got a chance to
        develop on a mesh that coarse. Removing this block and letting
        the first periodic adapt (period_in_timesteps=25 below) wait
        until real flow has developed fixes it: a direct test without
        this block showed CFL settling normally (~3, matching the
        non-adaptive case) through steps 1-25, then the periodic adapt at
        step 25 refined 15,000->31,000 nodes in response to actual flow
        features and the run continued with sane nonzero CFL afterward
        (0.24 at step 26). This is the same pitfall the
        flow_past_sphere_Re1000 example (which this adaptivity block was
        modelled on) works around with a separate prescribed proxy field
        for its own first-timestep adapt - simpler here to just not
        force an adapt before flow exists.
      -->
      <zoltan_options>
        <load_imbalance_tolerance>
          <real_value rank="0">1.1</real_value>
        </load_imbalance_tolerance>
      </zoltan_options>
      <adapt_iterations>
        <integer_value rank="0">4</integer_value>
      </adapt_iterations>
    </hr_adaptivity>
  </mesh_adaptivity>
</fluidity_options>
