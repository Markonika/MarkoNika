# Simulation run artifacts (regenerable by running the .flml) -- not tracked
run*.log
*.stat
*checkpoint*
msfr_wedge*_[0-9]*.vtu
msfr_wedge*_[0-9]*.pvtu
# false-positive exceptions: "_2d_" above accidentally matches the dump
# pattern (a digit right after an underscore) -- these are real geometry
# deliverables, not timestep dumps
!msfr_wedge_midplane_2d_geometry.vtu
!msfr_wedge_midplane_2d_remeshed_geometry.vtu
matrixdump
matrixdump.info
first_timestep_adapted_mesh.msh

# Throwaway diagnostic .flml variants (ad-hoc copies of a real case with
# one block removed/changed, used to isolate a bug by comparison) -- not
# tracked; the fix lands in the real .flml once found, these get deleted
*_test.flml
*_debug.flml
msfr_wedge_real_tet_noinitadapt.flml

# Large generated mesh files (regenerable by running gmsh on
# vtb_source/msfr_v2.geo, then export_fullcore_vtu.py) -- not tracked
msfr_fullcore_real.msh
msfr_fullcore_real_geometry.vtu
